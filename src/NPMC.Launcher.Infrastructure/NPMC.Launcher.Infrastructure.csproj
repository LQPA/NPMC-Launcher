<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPMC.Launcher.Core\NPMC.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 离线皮肤 javaagent（tools\skin-agent 的构建产物，打进程序以便单文件发布） -->
    <EmbeddedResource Include="Skins\Agent\nmpc-skin-agent.jar"
                      LogicalName="NPMC.Launcher.Infrastructure.SkinAgent.jar" />
    <EmbeddedResource Include="Skins\Agent\nmpc-skin-agent-legacy.jar"
                      LogicalName="NPMC.Launcher.Infrastructure.SkinAgent.Legacy.jar" />
  </ItemGroup>

</Project>