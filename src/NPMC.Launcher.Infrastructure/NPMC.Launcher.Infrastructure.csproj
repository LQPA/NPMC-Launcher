<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPMC.Launcher.Core\NPMC.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 离线皮肤 javaagent（tools\skin-agent 的构建产物，打进程序以便单文件发布）。
         nmpc-skin-agent.jar 是 -javaagent 的薄入口（AgentStub，**不含 ASM**）。
         JVM 会把 -javaagent 的 jar 放进系统类加载器，Fabric 的 verifyClasspath 数得到
         里面的 org/objectweb/asm —— 所以带 ASM 的实现必须拆成独立的 impl jar。 -->
    <EmbeddedResource Include="Skins\Agent\nmpc-skin-agent.jar"
                      LogicalName="NPMC.Launcher.Infrastructure.SkinAgent.jar" />
    <EmbeddedResource Include="Skins\Agent\nmpc-skin-agent-impl.jar"
                      LogicalName="NPMC.Launcher.Infrastructure.SkinAgent.Impl.jar" />
    <EmbeddedResource Include="Skins\Agent\nmpc-skin-agent-impl-legacy.jar"
                      LogicalName="NPMC.Launcher.Infrastructure.SkinAgent.Impl.Legacy.jar" />
    <!-- 桥接类单独一个 jar：只有它需要挂到 bootstrap（见 SkinAgent.prepareBridge） -->
    <EmbeddedResource Include="Skins\Agent\nmpc-skin-bridge.jar"
                      LogicalName="NPMC.Launcher.Infrastructure.SkinAgentBridge.jar" />
  </ItemGroup>

</Project>