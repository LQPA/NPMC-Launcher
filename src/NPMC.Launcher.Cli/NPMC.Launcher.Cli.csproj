<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>npmc</AssemblyName>
    <RootNamespace>NPMC.Launcher.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core 通过 Infrastructure 的传递引用获得，不重复直接引用（本机 SDK 对菱形引用还原异常） -->
    <ProjectReference Include="..\NPMC.Launcher.Infrastructure\NPMC.Launcher.Infrastructure.csproj" />
  </ItemGroup>

</Project>