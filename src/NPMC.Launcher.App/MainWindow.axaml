<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NPMC.Launcher.App.ViewModels"
        x:Class="NPMC.Launcher.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NPMC Launcher"
        Width="1080" Height="680"
        MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#1B1D23">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ================= 顶部 ================= -->
    <Border Grid.Row="0" Background="#23262E"
            BorderBrush="#31353F" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="NPMC Launcher" FontSize="18" FontWeight="SemiBold" Foreground="#F2F3F5" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding RootPath}" FontSize="11" Foreground="#949CA9"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding IntegrityText}" FontSize="11" Foreground="#6E7684" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="刷新" VerticalAlignment="Center"
                Command="{Binding RefreshCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="180,340,*">

      <!-- ================= 左侧导航 ================= -->
      <Border Background="#1F2229" BorderBrush="#31353F" BorderThickness="0,0,1,0" Padding="12,18">
        <StackPanel Spacing="4">
          <Border Background="#2B3A55" CornerRadius="6" Padding="12,9">
            <TextBlock Text="实例" FontSize="13" Foreground="#DCE4F5" />
          </Border>
          <Border CornerRadius="6" Padding="12,9" IsEnabled="False">
            <TextBlock Text="下载" FontSize="13" Foreground="#949CA9" />
          </Border>
          <Border CornerRadius="6" Padding="12,9" IsEnabled="False">
            <TextBlock Text="设置" FontSize="13" Foreground="#949CA9" />
          </Border>

          <TextBlock Margin="12,20,12,0" FontSize="11" Foreground="#6E7684"
                     TextWrapping="Wrap" LineHeight="17"
                     Text="下载与设置页在后续阶段接入。模组/资源包/光影管理在右侧页签里。" />
        </StackPanel>
      </Border>

      <!-- ================= 实例列表 ================= -->
      <Grid Grid.Column="1" Background="#1B1D23">

        <ListBox ItemsSource="{Binding Instances}"
                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Padding="8"
                 IsVisible="{Binding !IsEmpty}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:InstanceListItem">
              <StackPanel Spacing="3" Margin="2,5">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#E8EAED" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="#B4BCC8" />
                <TextBlock Text="{Binding ContentText}" FontSize="11" Foreground="#949CA9" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" Margin="24" IsVisible="{Binding IsEmpty}">
          <TextBlock Text="还没有实例" FontSize="14" Foreground="#B4BCC8"
                     HorizontalAlignment="Center" />
          <TextBlock Text="npmc instance create 原版生存 --version 1.20.1"
                     FontSize="11" Foreground="#949CA9" HorizontalAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <!-- ================= 右侧：标题 / 页签 / 主体 / 操作 ================= -->
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" Margin="24,20">

        <StackPanel Grid.Row="0" Spacing="3" IsVisible="{Binding HasSelection}">
          <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="24" FontWeight="SemiBold"
                     Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding SelectedInstance.SummaryText}" FontSize="12" Foreground="#B4BCC8" />
        </StackPanel>

        <!-- 页签（用横向 ListBox，选中样式由主题提供，不需要写转换器） -->
        <ListBox Grid.Row="1" Margin="0,14,0,0"
                 ItemsSource="{Binding ContentTabs}"
                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 IsVisible="{Binding HasSelection}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ContentTabItem">
              <TextBlock Text="{Binding DisplayTitle}" FontSize="12" Padding="12,5" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- 概览 -->
        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" IsVisible="{Binding ShowOverview}">
          <Border Background="#23262E" CornerRadius="8"
                  BorderBrush="#31353F" BorderThickness="1" Padding="16,14"
                  VerticalAlignment="Top">
            <StackPanel Spacing="9">

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="版本" FontSize="12" Foreground="#949CA9" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.VersionId}"
                           FontSize="12" Foreground="#C9CDD3" />
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="隔离级别" FontSize="12" Foreground="#949CA9" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.IsolationText}"
                           FontSize="12" Foreground="#C9CDD3" />
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="内存" FontSize="12" Foreground="#949CA9"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <NumericUpDown Value="{Binding MemoryMb, Mode=TwoWay}"
                                 Minimum="{Binding MinimalMemory}"
                                 Maximum="{Binding MaximalMemory}"
                                 Increment="256" FormatString="0"
                                 Width="130" />
                  <TextBlock Text="MB" FontSize="12" Foreground="#B4BCC8" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="窗口" FontSize="12" Foreground="#949CA9"
                           VerticalAlignment="Center" />
                <!--
                  用 WrapPanel：窗口拉窄时这组控件会换行，而不是把数字框挤成几像素。
                  数字框宽度按"能完整显示 3840"来定 —— 微调按钮会占掉约 34px。
                -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                  <ComboBox ItemsSource="{Binding ResolutionPresets}"
                            SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                            PlaceholderText="预设" Width="112" FontSize="12" Margin="0,0,6,0" />
                  <NumericUpDown Value="{Binding WindowWidth, Mode=TwoWay}"
                                 Minimum="{Binding MinimalWindowSideValue}"
                                 Maximum="{Binding MaximalWindowSideValue}"
                                 Increment="10" FormatString="0" Width="118" Margin="0,0,6,0" />
                  <TextBlock Text="×" FontSize="12" Foreground="#B4BCC8"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                  <NumericUpDown Value="{Binding WindowHeight, Mode=TwoWay}"
                                 Minimum="{Binding MinimalWindowSideValue}"
                                 Maximum="{Binding MaximalWindowSideValue}"
                                 Increment="10" FormatString="0" Width="118" />
                </WrapPanel>
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="内容" FontSize="12" Foreground="#949CA9" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.ContentText}"
                           FontSize="12" Foreground="#C9CDD3" />
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="创建时间" FontSize="12" Foreground="#949CA9" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.CreatedText}"
                           FontSize="12" Foreground="#C9CDD3" />
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="游戏目录" FontSize="12" Foreground="#949CA9" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.GameDirectory}"
                           FontSize="11" Foreground="#B4BCC8" TextWrapping="Wrap" />
              </Grid>

            </StackPanel>
          </Border>
        </ScrollViewer>

        <!-- 内容列表 -->
        <Grid Grid.Row="2" Margin="0,14,0,0" RowDefinitions="Auto,*"
              IsVisible="{Binding ShowContentList}">

          <!--
            搜索安装面板：只在模组页签出现。
            两步走 —— 先搜索、点「安装」解析出依赖计划，确认后才下载。
            直接把下载按钮做在搜索结果上会让用户不知道会额外装什么（Fabric API 之类）。
          -->
          <Border Grid.Row="0" Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                  CornerRadius="8" Padding="10" Margin="0,0,0,10"
                  IsVisible="{Binding IsContentList}">
            <StackPanel Spacing="8">

              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox Grid.Column="0" Text="{Binding SearchQuery}"
                         Watermark="{Binding SearchPlaceholder}" FontSize="12" />

                <!-- 搜索来源：CurseForge 需要 API key；它没有光影分类 -->
                <ComboBox Grid.Column="1" SelectedIndex="{Binding SearchSourceIndex}"
                          Width="120" Margin="8,0,0,0" FontSize="12">
                  <ComboBoxItem Content="Modrinth" />
                  <ComboBoxItem Content="CurseForge" IsEnabled="{Binding IsCurseForgeSearchAvailable}" />
                </ComboBox>

                <Button Grid.Column="2" Content="{Binding SearchButtonText}"
                        Command="{Binding SearchCommand}" Margin="8,0,0,0" FontSize="12" />
                <Button Grid.Column="3" Content="{Binding SearchPanelToggleText}"
                        Command="{Binding ToggleSearchPanelCommand}"
                        Margin="6,0,0,0" FontSize="12" Padding="8,4" />
              </Grid>

              <!-- 收起后只留搜索框，把高度还给下面的内容列表 -->
              <StackPanel Spacing="8" IsVisible="{Binding IsSearchPanelExpanded}">

              <TextBlock Text="{Binding SearchSummaryText}" FontSize="11" Foreground="#949CA9"
                         IsVisible="{Binding HasSearchSummary}" TextWrapping="Wrap" />

              <ScrollViewer MaxHeight="150" IsVisible="{Binding HasSearchResults}">
                <ItemsControl ItemsSource="{Binding SearchResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ModSearchResultItem">
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">

                        <!-- 来源徽标：与列表里的 M/C 配色一致 -->
                        <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                                Background="{Binding SourceColor}" VerticalAlignment="Center"
                                Margin="0,0,8,0" ToolTip.Tip="{Binding SourceLabel}">
                          <TextBlock Text="{Binding SourceBadge}" FontSize="10" FontWeight="Bold"
                                     Foreground="#FFFFFF" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="1">
                          <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#E8EAED" />
                          <TextBlock Text="{Binding MetaText}" FontSize="10" Foreground="#6E7684"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="2" Content="安装" Command="{Binding InstallCommand}"
                                FontSize="11" Padding="10,3" VerticalAlignment="Center"
                                Margin="8,0,0,0" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- 依赖计划确认 -->
              <Border Background="#1B1D23" CornerRadius="6" Padding="8"
                      IsVisible="{Binding IsPlanVisible}">
                <StackPanel Spacing="6">
                  <TextBlock Text="将安装以下文件" FontSize="11" Foreground="#B4BCC8" />

                  <!-- 版本下拉：该项目在当前游戏版本下的所有可用版本 -->
                  <Grid ColumnDefinitions="88,*" IsVisible="{Binding HasInstallVersions}">
                    <TextBlock Text="版本" FontSize="11" Foreground="#949CA9"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding InstallVersions}"
                              SelectedItem="{Binding SelectedInstallVersion}"
                              FontSize="11" MinHeight="26" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstallVersionChoice">
                          <TextBlock Text="{Binding DisplayLabel}" FontSize="11" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding PlanLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:InstallPlanLineItem">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                          <TextBlock Text="{Binding Label}" FontSize="11"
                                     Foreground="{Binding LabelColor}" Width="88" />
                          <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11"
                                     Foreground="#949CA9" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding InstallButtonText}" Command="{Binding ConfirmInstallCommand}"
                            FontSize="11" Padding="10,3" />
                    <Button Content="取消" Command="{Binding CancelPlanCommand}"
                            FontSize="11" Padding="10,3" />
                  </StackPanel>
                </StackPanel>
              </Border>

              </StackPanel>
            </StackPanel>
          </Border>

          <!--
            这里用 ItemsControl 而不是 ListBox：内容行不需要"选中"这个概念
            （每行自己带按钮），而 ListBox 的选中态会给行铺一层蓝色，
            把次要文字压得看不清。去掉选中态也就顺便消掉了这一类高亮问题。
          -->
          <Border Grid.Row="1" Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                  CornerRadius="8" Padding="8"
                  IsVisible="{Binding !IsContentEmpty}">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Content}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContentEntryItem">
                    <Grid ColumnDefinitions="32,*,Auto,Auto,Auto,Auto,Auto" Margin="4,5">

                      <!--
                        识别徽标：填充色块 + 字母。
                        不用平台 logo —— Modrinth 的 COPYING.md 明确禁止使用其品牌元素
                        （含任何变体，即便改色也不行），统一改用字母以示来源。
                        检查更新之前一律不显示：没查过就说"认不出"是错的。
                      -->
                      <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                              Background="#2E7D46" VerticalAlignment="Center"
                              IsVisible="{Binding IsFromModrinth}"
                              ToolTip.Tip="已在 Modrinth 识别">
                        <TextBlock Text="M" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                              Background="#A93226" VerticalAlignment="Center"
                              IsVisible="{Binding IsFromCurseForge}"
                              ToolTip.Tip="已在 CurseForge 识别">
                        <TextBlock Text="C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                              Background="#4D5560" VerticalAlignment="Center"
                              IsVisible="{Binding IsUnidentified}"
                              ToolTip.Tip="两个平台都无法识别（自制或未上传）">
                        <TextBlock Text="?" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8EAED"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="#949CA9"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <TextBlock Grid.Column="2" Text="{Binding UpdateText}" FontSize="11"
                                 Foreground="#7BC47F" VerticalAlignment="Center" Margin="10,0"
                                 IsVisible="{Binding HasUpdate}" />

                      <Button Grid.Column="3" Content="升级"
                              Command="{Binding UpgradeCommand}"
                              FontSize="11" Padding="10,3" Margin="0,0,6,0"
                              IsVisible="{Binding HasUpdate}" />

                      <TextBlock Grid.Column="4" Text="{Binding StatusText}" FontSize="11"
                                 Foreground="#B4BCC8" VerticalAlignment="Center" Margin="6,0" />

                      <Button Grid.Column="5" Content="{Binding ToggleText}"
                              Command="{Binding ToggleCommand}"
                              FontSize="11" Padding="10,3" Margin="0,0,6,0" />

                      <Button Grid.Column="6" Content="删除"
                              Command="{Binding DeleteCommand}"
                              FontSize="11" Padding="10,3" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" Margin="24" IsVisible="{Binding IsContentEmpty}">
            <TextBlock Text="{Binding ContentEmptyHint}" FontSize="12" Foreground="#949CA9"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" LineHeight="19" />
          </StackPanel>
        </Grid>

        <!-- 日志 -->
        <Grid Grid.Row="2" Margin="0,14,0,0" IsVisible="{Binding ShowLog}"
              RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="{Binding LogPathText}" FontSize="11" Foreground="#949CA9"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="刷新" FontSize="11" Padding="10,3"
                    Command="{Binding RefreshLogCommand}" />
          </Grid>

          <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                   Background="#16181D" Foreground="#C9CDD3"
                   BorderBrush="#31353F" BorderThickness="1" CornerRadius="8"
                   Padding="10" VerticalContentAlignment="Top" />
        </Grid>

        <!-- 操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0"
                    IsVisible="{Binding ShowOverview}">
          <Button Content="{Binding LaunchButtonText}" Command="{Binding LaunchGameCommand}" />
          <Button Content="打开游戏目录" Command="{Binding OpenGameFolderCommand}" />

          <!-- 目录入口按实际存在与否显示：没装光影就不该出现一个只会新建空文件夹的按钮 -->
          <Button Content="打开 mods" Command="{Binding OpenModsFolderCommand}"
                  IsVisible="{Binding HasModsDirectory}" />
          <Button Content="打开资源包" Command="{Binding OpenResourcePacksFolderCommand}"
                  IsVisible="{Binding HasResourcePacksDirectory}" />
          <Button Content="打开光影" Command="{Binding OpenShaderPacksFolderCommand}"
                  IsVisible="{Binding HasShaderPacksDirectory}" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0"
                    IsVisible="{Binding ShowContentList}">
          <Button Content="打开当前文件夹" Command="{Binding OpenContentFolderCommand}" />
          <Button Content="全部禁用" Command="{Binding DisableAllCommand}" />
          <Button Content="全部启用" Command="{Binding EnableAllCommand}" />

          <!-- 检查更新只对模组有意义 -->
          <Button Content="{Binding CheckUpdatesText}" Command="{Binding CheckUpdatesCommand}"
                  IsVisible="{Binding IsModsTab}" />

          <TextBlock Text="{Binding UpdateSummaryText}" IsVisible="{Binding HasUpdates}"
                     Foreground="#7BC47F" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- ================= 状态栏 ================= -->
    <Border Grid.Row="2" Background="#1F2229"
            BorderBrush="#31353F" BorderThickness="0,1,0,0" Padding="24,9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#949CA9"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding RootHint}" FontSize="11" Foreground="#6E7684" />
      </Grid>
    </Border>

  </Grid>
</Window>
