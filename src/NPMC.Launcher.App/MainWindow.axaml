<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NPMC.Launcher.App.ViewModels"
        xmlns:mc="using:NPMC.Launcher.Infrastructure.Minecraft"
        xmlns:mods="using:NPMC.Launcher.Infrastructure.Mods"
        x:Class="NPMC.Launcher.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="NPMC Launcher"
        Width="1280" Height="720"
        MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#1B1D23">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ================= 顶部 ================= -->
    <Border Grid.Row="0" Background="#23262E"
            BorderBrush="#31353F" BorderThickness="0,0,0,1" Padding="24,14">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="NPMC Launcher" FontSize="18" FontWeight="SemiBold" Foreground="#F2F3F5" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding RootPath}" FontSize="11" Foreground="#949CA9"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding IntegrityText}" FontSize="11" Foreground="#6E7684" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1" Content="刷新" VerticalAlignment="Center"
                Command="{Binding RefreshCommand}" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="180,340,*">

      <!-- ================= 左侧导航 ================= -->
      <Border Background="#1F2229" BorderBrush="#31353F" BorderThickness="0,0,1,0" Padding="12,18">
        <StackPanel Spacing="4">
          <Button Command="{Binding ShowInstancesCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="{Binding InstancesNavBackground}" BorderThickness="0" Padding="12,9">
            <TextBlock Text="实例" FontSize="13" Foreground="{Binding InstancesNavForeground}" />
          </Button>

          <Button Command="{Binding ShowDownloadsCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="{Binding DownloadsNavBackground}" BorderThickness="0" Padding="12,9">
            <TextBlock Text="下载" FontSize="13" Foreground="{Binding DownloadsNavForeground}" />
          </Button>

          <Button Command="{Binding ShowSettingsCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="{Binding SettingsNavBackground}" BorderThickness="0" Padding="12,9">
            <TextBlock Text="设置" FontSize="13" Foreground="{Binding SettingsNavForeground}" />
          </Button>

          <TextBlock Margin="12,20,12,0" FontSize="11" Foreground="#6E7684"
                     TextWrapping="Wrap" LineHeight="17"
                     Text="模组/资源包/光影/存档在实例右侧页签里。下载源、并发、代理、默认 Java 在「设置」。" />
        </StackPanel>
      </Border>

      <!-- ================= 实例列表 ================= -->
      <Grid Grid.Column="1" Background="#1B1D23" IsVisible="{Binding IsInstancesPage}">

        <ListBox x:Name="InstanceList"
                 ItemsSource="{Binding Instances}"
                 SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Padding="8"
                 IsVisible="{Binding !IsEmpty}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:InstanceListItem">
              <StackPanel Spacing="3" Margin="2,5">
                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                           Foreground="#E8EAED" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding SummaryText}" FontSize="12" Foreground="#B4BCC8" />
                <TextBlock Text="{Binding ContentText}" FontSize="11" Foreground="#949CA9" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" Margin="24" IsVisible="{Binding IsEmpty}">
          <TextBlock Text="还没有实例" FontSize="14" Foreground="#B4BCC8"
                     HorizontalAlignment="Center" />
          <TextBlock Text="npmc instance create 原版生存 --version 1.20.1"
                     FontSize="11" Foreground="#949CA9" HorizontalAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>

      <!-- ================= 右侧：标题 / 页签 / 主体 / 操作 ================= -->
      <Grid Grid.Column="2" RowDefinitions="Auto,Auto,*,Auto" Margin="24,20">

        <StackPanel Grid.Row="0" Spacing="3" IsVisible="{Binding ShowInstanceHeader}">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="24" FontWeight="SemiBold"
                       Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       IsVisible="{Binding !IsRenaming}" />
            <Button Grid.Column="1" Content="重命名" Command="{Binding BeginRenameCommand}"
                    FontSize="11" Padding="10,3" VerticalAlignment="Center"
                    IsVisible="{Binding !IsRenaming}" />

            <!-- 改名：只改显示名，不动实例目录 -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8"
                        IsVisible="{Binding IsRenaming}" VerticalAlignment="Center">
              <TextBox Text="{Binding RenameText, Mode=TwoWay}" Width="340" FontSize="13"
                       VerticalAlignment="Center" />
              <Button Content="保存" Command="{Binding ConfirmRenameCommand}" FontSize="12" />
              <Button Content="取消" Command="{Binding CancelRenameCommand}" FontSize="12" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding SelectedInstance.SummaryText}" FontSize="12" Foreground="#B4BCC8" />
        </StackPanel>

        <!-- 页签（用横向 ListBox，选中样式由主题提供，不需要写转换器） -->
        <ListBox Grid.Row="1" Margin="0,14,0,0" x:Name="TabStrip"
                 ItemsSource="{Binding ContentTabs}"
                 SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                 SelectionChanged="OnTabSelectionChanged"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 IsVisible="{Binding ShowInstanceHeader}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ContentTabItem">
              <TextBlock Text="{Binding DisplayTitle}" FontSize="12" Padding="0,5"
                         Width="76" TextAlignment="Center"
                         Foreground="{Binding TitleColor}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.Styles>
            <!--
              不给 ListBoxItem 设 IsEnabled：禁用后收不到指针事件，ToolTip 就不显示了，
              而"为什么不可用"恰恰要靠提示说清楚。改为可悬停 + 由 ViewModel 拒绝选中。
            -->
            <Style Selector="ListBoxItem" x:DataType="vm:ContentTabItem">
              <Setter Property="MinWidth" Value="88" />
              <Setter Property="HorizontalContentAlignment" Value="Center" />
              <Setter Property="ToolTip.Tip" Value="{Binding TabTip}" />
            </Style>
          </ListBox.Styles>
        </ListBox>

        <!-- 概览 -->
        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" IsVisible="{Binding ShowOverview}">
          <Border Background="#23262E" CornerRadius="8"
                  BorderBrush="#31353F" BorderThickness="1" Padding="16,14"
                  VerticalAlignment="Top">
            <StackPanel Spacing="9">

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="版本" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.VersionId}"
                           FontSize="12" Foreground="#C9CDD3" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="隔离级别" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.IsolationText}"
                           FontSize="12" Foreground="#C9CDD3" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="内存" FontSize="12" Foreground="#949CA9"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <NumericUpDown Value="{Binding MemoryMb, Mode=TwoWay}"
                                 Minimum="{Binding MinimalMemory}"
                                 Maximum="{Binding MaximalMemory}"
                                 Increment="256" FormatString="0"
                                 Width="130" />
                  <TextBlock Text="MB" FontSize="12" Foreground="#B4BCC8" VerticalAlignment="Center" />
                </StackPanel>
              </Grid>

              <!-- Java：默认由版本元数据决定，也可指定某个运行时或系统 JRE -->
              <!-- Java：控件高度与其它行一致，提示单独占一行，避免把本行撑高 -->
              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="Java" FontSize="12" Foreground="#949CA9"
                           VerticalAlignment="Center" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                  <ComboBox ItemsSource="{Binding JavaChoices}"
                            SelectedItem="{Binding SelectedJavaChoice, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" FontSize="12"
                            Height="30" VerticalAlignment="Center">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:JavaChoice">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                    <Button Grid.Column="1" Content="浏览…" Click="OnPickJavaClick"
                            Padding="12,0" Margin="6,0,0,0" FontSize="12" Height="30"
                            VerticalAlignment="Center" VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Center" />
                </Grid>
              </Grid>

              <Grid ColumnDefinitions="96,*" IsVisible="{Binding HasJavaHint}">
                <TextBlock Grid.Column="1" Text="{Binding JavaHint}" FontSize="10"
                           Foreground="#6E7684" TextWrapping="Wrap" />
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="窗口" FontSize="12" Foreground="#949CA9"
                           VerticalAlignment="Center" />
                <!--
                  用 WrapPanel：窗口拉窄时这组控件会换行，而不是把数字框挤成几像素。
                  数字框宽度按"能完整显示 3840"来定 —— 微调按钮会占掉约 34px。
                -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal">
                  <ComboBox ItemsSource="{Binding ResolutionPresets}"
                            SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                            PlaceholderText="预设" Width="112" FontSize="12" Margin="0,0,6,0" />
                  <NumericUpDown Value="{Binding WindowWidth, Mode=TwoWay}"
                                 Minimum="{Binding MinimalWindowSideValue}"
                                 Maximum="{Binding MaximalWindowSideValue}"
                                 Increment="10" FormatString="0" Width="118" Margin="0,0,6,0" />
                  <TextBlock Text="×" FontSize="12" Foreground="#B4BCC8"
                             VerticalAlignment="Center" Margin="0,0,6,0" />
                  <NumericUpDown Value="{Binding WindowHeight, Mode=TwoWay}"
                                 Minimum="{Binding MinimalWindowSideValue}"
                                 Maximum="{Binding MaximalWindowSideValue}"
                                 Increment="10" FormatString="0" Width="118" />
                </WrapPanel>
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="内容" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.ContentText}"
                           FontSize="12" Foreground="#C9CDD3" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="创建时间" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.CreatedText}"
                           FontSize="12" Foreground="#C9CDD3" VerticalAlignment="Center" />
              </Grid>

              <Grid ColumnDefinitions="96,*">
                <TextBlock Grid.Column="0" Text="游戏目录" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SelectedInstance.GameDirectory}"
                           FontSize="11" Foreground="#B4BCC8" TextWrapping="Wrap" />
              </Grid>

            </StackPanel>
          </Border>
        </ScrollViewer>

        <!-- 内容列表 -->
          <Grid Grid.Row="2" Margin="0,14,0,0" RowDefinitions="Auto,Auto,*,Auto"
                IsVisible="{Binding ShowContentPane}"
                DragDrop.AllowDrop="True" DragDrop.DragOver="OnContentDragOver" DragDrop.Drop="OnContentDrop">
            <!-- 存档列表：每个世界一行，操作直接挂在行上 -->
            <ScrollViewer Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ShowWorldPicker}">
              <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding Worlds}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorldItem">
                      <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                              CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8EAED" />
                            <TextBlock Text="{Binding LastPlayedText, StringFormat='最后游玩 {0}'}"
                                       FontSize="11" Foreground="#949CA9" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="打开目录" Command="{Binding OpenFolderCommand}"
                                  FontSize="12" Margin="8,0,0,0" />
                          <Button Grid.Column="2" Content="数据包" Command="{Binding ManageDataPacksCommand}"
                                  IsVisible="{Binding CanManageDataPacks}" FontSize="12" Margin="8,0,0,0" />
                          <Button Grid.Column="3" Content="删除" Command="{Binding DeleteCommand}"
                                  FontSize="12" Margin="8,0,0,0" Foreground="#E06C6C" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="可以把世界文件夹或 .zip 拖到这里导入（RAR / 7z 请先解压）"
                           FontSize="11" Foreground="#6E7684" IsVisible="{Binding !HasWorlds}" />

                <TextBlock Text="还没有世界。先在游戏里创建一个世界。" FontSize="11" Foreground="#6E7684"
                           IsVisible="{Binding !HasWorlds}" />
              </StackPanel>
            </ScrollViewer>

            <!-- 进入某个世界后：左上角可返回存档列表 -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10"
                        IsVisible="{Binding IsManagingDataPacks}">
              <Button Content="← 返回存档" Command="{Binding BackToWorldsCommand}" FontSize="12" />
              <TextBlock Text="{Binding DataPackWorld.Name}" FontSize="13" Foreground="#E8EAED"
                         VerticalAlignment="Center" />
              <TextBlock Text="（数据包按世界生效）" FontSize="11" Foreground="#6E7684"
                         VerticalAlignment="Center" />
            </StackPanel>

          <!--
            搜索安装面板：只在模组页签出现。
            两步走 —— 先搜索、点「安装」解析出依赖计划，确认后才下载。
            直接把下载按钮做在搜索结果上会让用户不知道会额外装什么（Fabric API 之类）。
          -->
          <Border Grid.Row="1" Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                  CornerRadius="8" Padding="10" Margin="0,0,0,10"
                  IsVisible="{Binding ShowContentList}">
            <StackPanel Spacing="8">

              <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                <TextBox Grid.Column="0" Text="{Binding SearchQuery}"
                         Watermark="{Binding SearchPlaceholder}" FontSize="12" />
                <!-- 搜索来源：CurseForge 需要 API key；它没有光影分类 -->
                <ComboBox Grid.Column="1" SelectedIndex="{Binding SearchSourceIndex}"
                          Width="120" Margin="8,0,0,0" FontSize="12">
                  <ComboBoxItem Content="Modrinth" />
                  <ComboBoxItem Content="CurseForge" IsEnabled="{Binding IsCurseForgeSearchAvailable}" />
                </ComboBox>

                <Button Grid.Column="2" Content="{Binding SearchButtonText}"
                        Command="{Binding SearchCommand}" Margin="8,0,0,0" FontSize="12" />
                <Button Grid.Column="3" Content="{Binding SearchPanelToggleText}"
                        Command="{Binding ToggleSearchPanelCommand}"
                        Margin="6,0,0,0" FontSize="12" Padding="8,4" />
              </Grid>

              <!-- 收起后只留搜索框，把高度还给下面的内容列表 -->
              <StackPanel Spacing="8" IsVisible="{Binding IsSearchPanelExpanded}">

              <TextBlock Text="{Binding SearchSummaryText}" FontSize="11" Foreground="#949CA9"
                         IsVisible="{Binding HasSearchSummary}" TextWrapping="Wrap" />

              <!--
                固定高度（而不是让内容撑开）：详情正文从"正在加载…"变成多行时，
                若高度随内容变化，整个搜索面板会伸缩，下面的列表就会上下跳。
                固定后内容变化只影响内部滚动。
              -->
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Height="200"
                    IsVisible="{Binding HasSearchResults}">
                <ScrollViewer Grid.Column="0">
                  <ListBox ItemsSource="{Binding SearchResults}"
                           SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                           Background="Transparent" BorderThickness="0" Padding="0">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ModSearchResultItem">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,3">

                          <!-- 来源徽标 + 缩小后的项目图标 -->
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                      VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border Width="18" Height="18" CornerRadius="4"
                                    Background="{Binding SourceColor}"
                                    ToolTip.Tip="{Binding SourceLabel}">
                              <TextBlock Text="{Binding SourceBadge}" FontSize="10" FontWeight="Bold"
                                         Foreground="#FFFFFF" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Border>

                            <!-- 图标未下载完时为 null，Image 什么都不画，但尺寸已占位，列表不会跳动 -->
                            <Image Source="{Binding Icon}" Width="22" Height="22" />
                          </StackPanel>

                          <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#E8EAED" />
                            <TextBlock Text="{Binding MetaText}" FontSize="10" Foreground="#6E7684"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="2" Content="安装" Command="{Binding InstallCommand}"
                                  FontSize="11" Padding="10,3" VerticalAlignment="Center"
                                  Margin="8,0,0,0" />
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>

                <!-- 选中某条结果后显示详情：同系列模组名字太像，只有详情能分辨 -->
                <Border Grid.Column="1" Background="#1B1D23" CornerRadius="6" Padding="10"
                        IsVisible="{Binding IsDetailVisible}">
                  <ScrollViewer>
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="Auto,*">
                        <!-- 详情里的图标按 56px 显示 -->
                        <Image Grid.Column="0" Source="{Binding DetailIcon}" Width="56" Height="56"
                               Margin="0,0,10,0" VerticalAlignment="Top" />

                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding DetailTitle}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="#E8EAED" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding DetailSubtitle}" FontSize="10" Foreground="#6E7684"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>

                      <!-- 机器翻译放在原文**上方**：先看中文判断是不是自己要的，需要时再读原文 -->
                      <Border Background="#20242B" CornerRadius="4" Padding="8"
                              IsVisible="{Binding HasDetailTranslation}">
                        <StackPanel Spacing="3">
                          <TextBlock Text="机器翻译" FontSize="9" Foreground="#6E7684" />
                          <TextBlock Text="{Binding DetailTranslation}" FontSize="11"
                                     Foreground="#9FB4A8" TextWrapping="Wrap" LineHeight="16" />
                        </StackPanel>
                      </Border>

                      <TextBlock Text="{Binding DetailBody}" FontSize="11" Foreground="#B4BCC8"
                                 TextWrapping="Wrap" LineHeight="16" />

                      <Button Content="在浏览器中打开" Command="{Binding OpenDetailInBrowserCommand}"
                              FontSize="11" Padding="10,3" HorizontalAlignment="Left" />
                    </StackPanel>
                  </ScrollViewer>
                </Border>
              </Grid>

              <!-- 依赖计划确认 -->
              <Border Background="#1B1D23" CornerRadius="6" Padding="8"
                      IsVisible="{Binding IsPlanVisible}">
                <StackPanel Spacing="6">
                  <TextBlock Text="将安装以下文件" FontSize="11" Foreground="#B4BCC8" />

                  <!-- 版本下拉：该项目在当前游戏版本下的所有可用版本 -->
                  <Grid ColumnDefinitions="88,*" IsVisible="{Binding HasInstallVersions}">
                    <TextBlock Text="版本" FontSize="11" Foreground="#949CA9"
                               VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding InstallVersions}"
                              SelectedItem="{Binding SelectedInstallVersion}"
                              FontSize="11" MinHeight="26" HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:InstallVersionChoice">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <!-- 版本类型徽标：R 正式 / B beta / A alpha，与来源徽标同一套风格 -->
                            <Border Width="16" Height="16" CornerRadius="3"
                                    Background="{Binding TypeColor}" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding TypeLabel}">
                              <TextBlock Text="{Binding TypeBadge}" FontSize="9" FontWeight="Bold"
                                         Foreground="#FFFFFF" HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Label}" FontSize="11" VerticalAlignment="Center" />
                          </StackPanel>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding PlanLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:InstallPlanLineItem">
                        <Grid ColumnDefinitions="Auto,*" Margin="0,1">
                          <TextBlock Text="{Binding Label}" FontSize="11"
                                     Foreground="{Binding LabelColor}" Width="88" />
                          <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11"
                                     Foreground="#949CA9" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding InstallButtonText}" Command="{Binding ConfirmInstallCommand}"
                            FontSize="11" Padding="10,3" />
                    <Button Content="取消" Command="{Binding CancelPlanCommand}"
                            FontSize="11" Padding="10,3" />
                  </StackPanel>
                </StackPanel>
              </Border>

              </StackPanel>
            </StackPanel>
          </Border>

          <!--
            这里用 ItemsControl 而不是 ListBox：内容行不需要"选中"这个概念
            （每行自己带按钮），而 ListBox 的选中态会给行铺一层蓝色，
            把次要文字压得看不清。去掉选中态也就顺便消掉了这一类高亮问题。
          -->
          <Border Grid.Row="2" Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                  CornerRadius="8" Padding="8"
                  IsVisible="{Binding ShowContentList}">
            <ScrollViewer>
              <ItemsControl ItemsSource="{Binding Content}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ContentEntryItem">
                    <Grid ColumnDefinitions="60,30,*,Auto,Auto,Auto,Auto,Auto" Margin="4,5">

                      <!--
                        项目图标 + 识别徽标。
                        图标未就绪时留空但保持 26px 占位，避免徽标左右跳动。
                      -->
                      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4"
                                  VerticalAlignment="Center">
                        <Image Source="{Binding Icon}" Width="26" Height="26" />
                        <Border Width="26" Height="26" CornerRadius="6"
                                Background="#2E7D46"
                                IsVisible="{Binding IsFromModrinth}"
                                ToolTip.Tip="已在 Modrinth 识别">
                          <TextBlock Text="M" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Width="26" Height="26" CornerRadius="6"
                                Background="#A93226"
                                IsVisible="{Binding IsFromCurseForge}"
                                ToolTip.Tip="已在 CurseForge 识别">
                          <TextBlock Text="C" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border Width="26" Height="26" CornerRadius="6"
                                Background="#4D5560"
                                IsVisible="{Binding IsUnidentified}"
                                ToolTip.Tip="两个平台都无法识别（自制或未上传）">
                          <TextBlock Text="?" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                      </StackPanel>

                      <!--
                        版本通道：R 正式版 / B beta / A alpha。
                        单独占一列（固定列宽），这样没有通道的行不会让标题左右跳动。
                      -->
                      <Border Grid.Column="1" Width="26" Height="26" CornerRadius="6"
                              Background="{Binding ChannelColor}" VerticalAlignment="Center"
                              IsVisible="{Binding HasChannel}"
                              ToolTip.Tip="{Binding ChannelLabel}">
                        <TextBlock Text="{Binding ChannelBadge}" FontSize="13" FontWeight="Bold"
                                   Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>

                      <StackPanel Grid.Column="2" Spacing="2">
                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E8EAED"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MetaText}" FontSize="11" Foreground="#949CA9"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>

                      <TextBlock Grid.Column="3" Text="{Binding UpdateText}" FontSize="11"
                                 Foreground="#7BC47F" VerticalAlignment="Center" Margin="10,0"
                                 IsVisible="{Binding HasUpdate}" />

                      <Button Grid.Column="4" Content="升级"
                              Command="{Binding UpgradeCommand}"
                              FontSize="11" Padding="10,3" Margin="0,0,6,0"
                              IsVisible="{Binding HasUpdate}" />

                      <TextBlock Grid.Column="5" Text="{Binding StatusText}" FontSize="11"
                                 Foreground="#B4BCC8" VerticalAlignment="Center" Margin="6,0" />

                      <Button Grid.Column="6" Content="{Binding ToggleText}"
                              Command="{Binding ToggleCommand}"
                              FontSize="11" Padding="10,3" Margin="0,0,6,0" />

                      <Button Grid.Column="7" Content="删除"
                              Command="{Binding DeleteCommand}"
                              FontSize="11" Padding="10,3" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                      Spacing="8" Margin="24" IsVisible="{Binding IsContentEmptyOrNotList}">
            <TextBlock Text="{Binding ContentEmptyHint}" FontSize="12" Foreground="#949CA9"
                       TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center" LineHeight="19" />
          </StackPanel>

            <!-- 存档页签的操作行（世界列表 / 数据包管理各给一个入口） -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0"
                        IsVisible="{Binding IsDataPackTab}">
              <Button Content="打开存档根目录" Command="{Binding OpenSavesFolderCommand}"
                      IsVisible="{Binding ShowWorldPicker}" FontSize="12" />
              <Button Content="打开该世界的数据包目录" Command="{Binding OpenDatapacksFolderCommand}"
                      IsVisible="{Binding IsManagingDataPacks}" FontSize="12" />
            </StackPanel>
        </Grid>

        <!-- 日志 -->
        <Grid Grid.Row="2" Margin="0,14,0,0" IsVisible="{Binding ShowLog}"
              RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock Text="{Binding LogPathText}" FontSize="11" Foreground="#949CA9"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="刷新" FontSize="11" Padding="10,3"
                    Command="{Binding RefreshLogCommand}" />
          </Grid>

          <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                   IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                   Background="#16181D" Foreground="#C9CDD3"
                   BorderBrush="#31353F" BorderThickness="1" CornerRadius="8"
                   Padding="10" VerticalContentAlignment="Top" />
        </Grid>

        <!-- 操作 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0"
                    IsVisible="{Binding ShowOverview}">
          <Button Content="{Binding LaunchButtonText}" Command="{Binding LaunchGameCommand}" />
          <Button Content="打开游戏目录" Command="{Binding OpenGameFolderCommand}" />

          <!-- 目录入口按实际存在与否显示：没装光影就不该出现一个只会新建空文件夹的按钮 -->
          <Button Content="打开 mods" Command="{Binding OpenModsFolderCommand}"
                  IsVisible="{Binding HasModsDirectory}" />
          <Button Content="打开资源包" Command="{Binding OpenResourcePacksFolderCommand}"
                  IsVisible="{Binding HasResourcePacksDirectory}" />
          <Button Content="打开光影" Command="{Binding OpenShaderPacksFolderCommand}"
                  IsVisible="{Binding HasShaderPacksDirectory}" />
          <Button Content="打开存档" Command="{Binding OpenSavesFolderCommand}"
                  IsVisible="{Binding HasSavesDirectory}"
                  ToolTip.Tip="打开 saves 目录（世界存档都在这里）" />
          <!-- 删除实例：两次点击确认，避免误删 -->
          <Button Content="{Binding DeleteInstanceText}" Command="{Binding DeleteInstanceCommand}"
                  Margin="18,0,0,0" Foreground="#E06C6C" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0"
                    IsVisible="{Binding ShowContentList}">
          <Button Content="打开当前文件夹" Command="{Binding OpenContentFolderCommand}" />
          <Button Content="全部禁用" Command="{Binding DisableAllCommand}" IsVisible="{Binding ShowContentList}" />
          <Button Content="全部启用" Command="{Binding EnableAllCommand}" IsVisible="{Binding ShowContentList}" />
          <TextBlock Text="也可以把文件直接拖进列表导入（模组 .jar，其余 .zip）"
                     IsVisible="{Binding IsContentList}" FontSize="11" Foreground="#6E7684"
                     VerticalAlignment="Center" Margin="6,0,0,0" />

          <!-- 检查更新只对模组有意义 -->
          <Button Content="{Binding CheckUpdatesText}" Command="{Binding CheckUpdatesCommand}"
                  IsVisible="{Binding IsModsTab}" />

          <TextBlock Text="{Binding UpdateSummaryText}" IsVisible="{Binding HasUpdates}"
                     Foreground="#7BC47F" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0" />
        </StackPanel>
      </Grid>

      <!-- ================= 下载页：左边两个分类 ================= -->
      <Border Grid.Column="1" Background="#1B1D23" Padding="12,14"
              IsVisible="{Binding IsDownloadsPage}">
        <StackPanel Spacing="4">
          <Button Command="{Binding ShowVersionsModeCommand}" BorderThickness="0" Padding="12,9"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="{Binding VersionsModeBackground}">
            <TextBlock Text="游戏本体" FontSize="13" Foreground="{Binding VersionsModeForeground}" />
          </Button>

          <Button Command="{Binding ShowModpacksModeCommand}" BorderThickness="0" Padding="12,9"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                  Background="{Binding ModpacksModeBackground}">
            <TextBlock Text="整合包" FontSize="13" Foreground="{Binding ModpacksModeForeground}" />
          </Button>
        </StackPanel>
      </Border>

      <!-- ================= 下载页：右边详情与操作 ================= -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="24,20"
            IsVisible="{Binding IsVersionsMode}">

        <!-- 版本改成下拉：左侧只留分类，不再占一整列列表 -->
        <StackPanel Grid.Row="0" Spacing="8">
          <TextBlock Text="游戏本体" FontSize="22" FontWeight="SemiBold" Foreground="#E8EAED" />

          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding DownloadVersions}"
                      SelectedItem="{Binding SelectedDownloadVersion}"
                      HorizontalAlignment="Stretch" FontSize="12">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadVersionItem">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="16" Height="16" CornerRadius="3" Background="{Binding TypeColor}"
                            VerticalAlignment="Center" ToolTip.Tip="{Binding TypeLabel}">
                      <TextBlock Text="{Binding TypeBadge}" FontSize="9" FontWeight="Bold"
                                 Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- 版本类型：四类互斥，切换时只在本地过滤（清单进页时一次性全量拉回） -->
            <ComboBox Grid.Column="1" SelectedIndex="{Binding VersionFilterIndex}"
                      Width="160" Margin="10,0,0,0" FontSize="12" VerticalAlignment="Center">
              <ComboBoxItem Content="正式版" />
              <ComboBoxItem Content="快照版本" />
              <ComboBoxItem Content="早期版本" />
              <ComboBoxItem Content="愚人节版本" />
            </ComboBox>
          </Grid>

          <TextBlock Text="{Binding DownloadVersionSubtitle}" FontSize="11" Foreground="#949CA9" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
          <StackPanel Spacing="14">
            <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="12">
                <TextBlock Text="安装内容" FontSize="12" Foreground="#B4BCC8" />

                <!-- 加载器四选一：一个实例只能挂一个加载器的 profile；没有对应版本的项会置灰 -->
                <Grid ColumnDefinitions="64,*">
                  <TextBlock Text="模组加载器" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <RadioButton GroupName="LoaderPick" Content="原版" FontSize="12"
                                 IsChecked="{Binding IsVanillaSelected, Mode=TwoWay}" />
                    <RadioButton GroupName="LoaderPick" Content="Fabric" FontSize="12"
                                 IsChecked="{Binding IsFabricSelected, Mode=TwoWay}"
                                 IsEnabled="{Binding CanSelectFabric}" />
                    <RadioButton GroupName="LoaderPick" Content="Forge" FontSize="12"
                                 IsChecked="{Binding IsForgeSelected, Mode=TwoWay}"
                                 IsEnabled="{Binding CanSelectForge}" />
                    <RadioButton GroupName="LoaderPick" Content="NeoForge" FontSize="12"
                                 IsChecked="{Binding IsNeoForgeSelected, Mode=TwoWay}"
                                 IsEnabled="{Binding CanSelectNeoForge}" />
                    <Button Content="重新检查" Command="{Binding RefreshLoadersCommand}"
                            FontSize="10" Padding="8,2" VerticalAlignment="Center"
                            IsVisible="{Binding !IsCheckingLoaders}"
                            ToolTip.Tip="跳过缓存，重新向 Fabric / Forge / NeoForge 查询该版本的加载器" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="64,*" IsVisible="{Binding ShowFabricVersions}">
                  <TextBlock Text="Fabric" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding FabricLoaderVersions}"
                            SelectedItem="{Binding SelectedFabricLoader}"
                            FontSize="12" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="mc:FabricLoaderVersion">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <!-- R/B/A 版本标识（与内容列表同一套颜色） -->
                          <Border Width="16" Height="16" CornerRadius="3"
                                  Background="{Binding ChannelColor}" VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding ChannelLabel}">
                            <TextBlock Text="{Binding ChannelBadge}" FontSize="9" FontWeight="Bold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="64,*" IsVisible="{Binding ShowForgeVersions}">
                  <TextBlock Text="Forge" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding ForgeLoaderVersions}"
                            SelectedItem="{Binding SelectedForgeLoader}"
                            FontSize="12" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="mods:ForgeLoaderVersion">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Width="16" Height="16" CornerRadius="3"
                                  Background="{Binding ChannelColor}" VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding ChannelLabel}">
                            <TextBlock Text="{Binding ChannelBadge}" FontSize="9" FontWeight="Bold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="64,*" IsVisible="{Binding ShowNeoForgeVersions}">
                  <TextBlock Text="NeoForge" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding NeoForgeLoaderVersions}"
                            SelectedItem="{Binding SelectedNeoForgeLoader}"
                            FontSize="12" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="mods:ForgeLoaderVersion">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Border Width="16" Height="16" CornerRadius="3"
                                  Background="{Binding ChannelColor}" VerticalAlignment="Center"
                                  ToolTip.Tip="{Binding ChannelLabel}">
                            <TextBlock Text="{Binding ChannelBadge}" FontSize="9" FontWeight="Bold"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding DisplayText}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </Grid>

                <TextBlock Text="{Binding LoaderHint}" Margin="64,0,0,0" FontSize="10" Foreground="#6E7684"
                           TextWrapping="Wrap" IsVisible="{Binding HasLoaderHint}" />

                <Grid ColumnDefinitions="64,*">
                  <TextBlock Text="实例名" FontSize="12" Foreground="#949CA9" VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding DownloadInstanceName}"
                           Watermark="留空则用版本号" FontSize="12" />
                </Grid>

                <!-- 重名会被拦住：两个同名实例在列表里根本分不清 -->
                <TextBlock Text="已存在同名实例，请改成别的名字" FontSize="10" Foreground="#E0A458"
                           IsVisible="{Binding DownloadConflictsWithExisting}" />
              </StackPanel>
            </Border>

            <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Text="将下载" FontSize="12" Foreground="#B4BCC8" />
                <TextBlock Text="client.jar · 库 · log4j 配置 · assetIndex · 资源对象（约 620 MB）"
                           FontSize="11" Foreground="#949CA9" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DownloadStatus}" FontSize="11" Foreground="#B4BCC8"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding DownloadProgressText}" FontSize="11" Foreground="#7BC47F"
                           TextWrapping="Wrap" />

                <ProgressBar Value="{Binding DownloadProgress}" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding DownloadProgressIndeterminate}"
                             IsVisible="{Binding IsDownloading}"
                             Height="6" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
          <Button Content="下载并创建实例" Command="{Binding DownloadCommand}"
                  IsEnabled="{Binding !IsDownloading}" />
        </StackPanel>
      </Grid>

      <!-- 下载页：整合包（本地 .mrpack，可选择或拖入） -->      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto" Margin="24,20"
            IsVisible="{Binding IsModpacksMode}">
        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="整合包" FontSize="22" FontWeight="SemiBold" Foreground="#E8EAED" />
          <TextBlock Text="选择一个 .mrpack 文件，或直接把它拖到下面的框里"
                     FontSize="12" Foreground="#949CA9" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
          <StackPanel Spacing="14">
            <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                    CornerRadius="8" Padding="24" MinHeight="170"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="OnModpackDragOver"
                    DragDrop.Drop="OnModpackDrop">
              <StackPanel Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="把 .mrpack 拖到这里" FontSize="13" Foreground="#B4BCC8"
                           HorizontalAlignment="Center" />
                <TextBlock Text="或者" FontSize="11" Foreground="#6E7684" HorizontalAlignment="Center" />
                <Button Content="选择文件…" Click="OnPickModpackClick"
                        HorizontalAlignment="Center" Padding="14,6" />
              </StackPanel>
            </Border>

            <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                    CornerRadius="8" Padding="16" IsVisible="{Binding HasModpackPlan}">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding ModpackTitle}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#E8EAED" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ModpackSummary}" FontSize="11" Foreground="#949CA9"
                           TextWrapping="Wrap" />
                <TextBlock Text="安装会下载对应的游戏本体与加载器，并把文件与覆盖层写进新实例。"
                           FontSize="10" Foreground="#6E7684" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                    CornerRadius="8" Padding="16">
              <StackPanel Spacing="6">
                <TextBlock Text="状态" FontSize="12" Foreground="#B4BCC8" />
                <TextBlock Text="{Binding ModpackStatus}" FontSize="11" Foreground="#B4BCC8"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding ModpackProgress}" FontSize="11" Foreground="#7BC47F"
                           TextWrapping="Wrap" />

                <ProgressBar Value="{Binding ModpackProgressPercent}" Minimum="0" Maximum="100"
                             IsIndeterminate="{Binding ModpackProgressIndeterminate}"
                             IsVisible="{Binding IsInstallingModpack}"
                             Height="6" Margin="0,6,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
          <Button Content="安装整合包" Command="{Binding InstallModpackCommand}"
                  IsEnabled="{Binding !IsInstallingModpack}" />
        </StackPanel>
      </Grid>

      <!-- ================= 设置页 ================= -->
      <Grid Grid.Column="1" Grid.ColumnSpan="2" RowDefinitions="Auto,*,Auto" Margin="24,20"
            IsVisible="{Binding IsSettingsPage}">

        <StackPanel Grid.Row="0" Spacing="4">
          <TextBlock Text="设置" FontSize="22" FontWeight="SemiBold" Foreground="#E8EAED" />
          <TextBlock Text="{Binding SettingsPath}" FontSize="11" Foreground="#949CA9"
                     TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0">
          <StackPanel Spacing="12" MaxWidth="1000" HorizontalAlignment="Stretch">

            <!-- 下载源 -->
            <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="下载源" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" />

                <Grid ColumnDefinitions="110,*">
                  <TextBlock Text="首选源" FontSize="12" Foreground="#949CA9"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" SelectedIndex="{Binding SettingsSourceIndex, Mode=TwoWay}"
                            Width="220" HorizontalAlignment="Left" FontSize="12">
                    <ComboBoxItem Content="官方（Mojang）" />
                    <ComboBoxItem Content="BMCLAPI 镜像" />
                  </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="110,*">
                  <TextBlock Text="镜像地址" FontSize="12" Foreground="#949CA9"
                             VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding SettingsMirrorUrl, Mode=TwoWay}"
                           FontSize="12" Watermark="https://bmclapi2.bangbang93.com" />
                </Grid>

                <CheckBox Content="首选源失败时自动回退到另一个源" Margin="110,0,0,0"
                          IsChecked="{Binding SettingsAllowFallback, Mode=TwoWay}" FontSize="12" />

                <TextBlock Text="{Binding SettingsSourceText}" Margin="110,0,0,0"
                           FontSize="11" Foreground="#6E7684" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- 下载与网络 -->
            <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="下载与网络" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" />

                <Grid ColumnDefinitions="110,*">
                  <TextBlock Text="并发下载" FontSize="12" Foreground="#949CA9"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding SettingsConcurrency, Mode=TwoWay}"
                                   Minimum="1" Maximum="64" Increment="1" FormatString="0"
                                   Width="120" FontSize="12" />
                    <TextBlock Text="同时下载的文件数（1~64）" FontSize="11" Foreground="#6E7684"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="110,*">
                  <TextBlock Text="请求超时" FontSize="12" Foreground="#949CA9"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding SettingsTimeoutSeconds, Mode=TwoWay}"
                                   Minimum="30" Maximum="3600" Increment="30" FormatString="0"
                                   Width="120" FontSize="12" />
                    <TextBlock Text="{Binding SettingsTimeoutText}" FontSize="11" Foreground="#6E7684"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>

                <Grid ColumnDefinitions="110,*">
                  <TextBlock Text="代理" FontSize="12" Foreground="#949CA9"
                             VerticalAlignment="Center" />
                  <TextBox Grid.Column="1" Text="{Binding SettingsProxy, Mode=TwoWay}" FontSize="12"
                           Watermark="http://127.0.0.1:7890（留空 = 直连）" />
                </Grid>

                <TextBlock Text="{Binding SettingsProxyText}" Margin="110,0,0,0"
                           FontSize="11" Foreground="#6E7684" TextWrapping="Wrap" />
                <TextBlock Text="超时与代理在新建网络连接时读取，改完需要重启启动器。" Margin="110,0,0,0"
                           FontSize="11" Foreground="#6E7684" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <!-- 实例默认 -->
            <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="实例默认" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" />

                <Grid ColumnDefinitions="110,*">
                  <TextBlock Text="默认内存" FontSize="12" Foreground="#949CA9"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <NumericUpDown Value="{Binding SettingsDefaultMemory, Mode=TwoWay}"
                                   Minimum="512" Maximum="65536" Increment="256" FormatString="0"
                                   Width="130" FontSize="12" />
                    <TextBlock Text="MB · 新建实例时的默认值（实例页里可以单独改）"
                               FontSize="11" Foreground="#6E7684" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Java 全局默认与预下载 -->
            <Border Background="#23262E" BorderBrush="#31353F" BorderThickness="1"
                    CornerRadius="8" Padding="16,14">
              <StackPanel Spacing="10">
                <TextBlock Text="Java" FontSize="13" FontWeight="SemiBold" Foreground="#E8EAED" />

                <Grid ColumnDefinitions="110,*,Auto">
                  <TextBlock Text="全局默认" FontSize="12" Foreground="#949CA9"
                             VerticalAlignment="Center" />
                  <ComboBox Grid.Column="1" ItemsSource="{Binding SettingsJavaChoices}"
                            SelectedItem="{Binding SettingsJavaChoice, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" FontSize="12">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:JavaChoice">
                        <TextBlock Text="{Binding Label}" FontSize="12" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2" Content="浏览…" Click="OnPickSettingsJavaClick"
                          Margin="8,0,0,0" FontSize="12" Height="30" Padding="12,0"
                          VerticalContentAlignment="Center" />
                </Grid>

                <TextBlock Text="{Binding SettingsJavaHint}" Margin="110,0,0,0"
                           FontSize="11" Foreground="#6E7684" TextWrapping="Wrap" />

                <Border Background="#1B1D23" CornerRadius="6" Padding="12" Margin="110,4,0,0">
                  <StackPanel Spacing="8">
                    <TextBlock Text="预下载 Java 运行时" FontSize="12" Foreground="#B4BCC8" />
                    <TextBlock Text="从 Mojang 官方源下载整套运行时到本启动器目录，之后启动对应版本的实例就不用现下。"
                               FontSize="10" Foreground="#6E7684" TextWrapping="Wrap" />

                    <Grid ColumnDefinitions="*,Auto">
                      <ComboBox ItemsSource="{Binding RuntimeChoices}"
                                SelectedItem="{Binding SettingsRuntime, Mode=TwoWay}"
                                HorizontalAlignment="Stretch" FontSize="12">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:RuntimeChoiceItem">
                            <TextBlock Text="{Binding Label}" FontSize="12" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="1" Content="下载" Command="{Binding InstallRuntimeCommand}"
                              Margin="8,0,0,0" FontSize="12" Height="30" Padding="16,0"
                              VerticalContentAlignment="Center" />
                    </Grid>

                    <ProgressBar Value="{Binding RuntimeInstallPercent}" Minimum="0" Maximum="100"
                                 IsIndeterminate="{Binding RuntimeInstallIndeterminate}"
                                 IsVisible="{Binding IsInstallingRuntime}" Height="6" />
                    <TextBlock Text="{Binding RuntimeInstallStatus}" FontSize="11" Foreground="#949CA9"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <TextBlock Text="界面语言目前只有简体中文；多语言要等界面文案抽出来之后再做。"
                       FontSize="11" Foreground="#6E7684" TextWrapping="Wrap" />
          </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,16,0,0">
          <Button Content="打开设置文件所在目录" Command="{Binding OpenSettingsFolderCommand}" FontSize="12" />
          <Button Content="恢复默认" Command="{Binding ResetSettingsCommand}" FontSize="12" />
          <TextBlock Text="{Binding SettingsStatus}" FontSize="11" Foreground="#7BC47F"
                     VerticalAlignment="Center" Margin="6,0,0,0" />
        </StackPanel>
      </Grid>
    </Grid>

    <!-- ================= 状态栏 ================= -->
    <Border Grid.Row="2" Background="#1F2229"
            BorderBrush="#31353F" BorderThickness="0,1,0,0" Padding="24,9">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" FontSize="11" Foreground="#949CA9"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="1" Text="{Binding RootHint}" FontSize="11" Foreground="#6E7684" />
      </Grid>
    </Border>

  </Grid>
</Window>
