# ---- dotnet CLI 缓存重定向 ----
/.dotnet-home/
/.nuget/

# ---- 运行时数据目录（约 820MB）----
# 注意：这些模式必须用前导 / 锚定到仓库根。
# 本仓库 core.ignorecase = true（Windows 大小写不敏感），
# 若写成 "instances/" 会同时匹配 src/NPMC.Launcher.Core/Instances/，
# 把源码目录静默忽略掉；"runtime/" 也会误伤 src/.../Runtime/。
/.data/
# 早期用 --root .\data 试跑留下的安装（与 .data 内容重复）。
# 注意：这个目录曾经因为只写了 /.data/ 而漏网，被误提交过一次 —— 见 9054dd4 的重写记录。
/data/
/runtime/
/libraries/
/versions/
/assets/
/instances/
/saves/

# ---- 构建产物 ----
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo

# ---- IDE ----
.idea/
.vs/

# ---- 本机专用脚本，不入库 ----
# 含本机环境相关 workaround：DOTNET_CLI_HOME 重定向、-m:1 规避 SDK 缺陷
/build.ps1
/push.ps1

# ---- 其它 ----
*.log
*.tmp
Thumbs.db
desktop.ini

# ---- 代码签名产物：私钥绝不入库 ----
# tools/sign-local.ps1 只用 Export-Certificate 导出公钥到临时目录，私钥留在证书存储里；
# 但手动用 signtool 或 Export-PfxCertificate 很容易在仓库里生成带私钥的 .pfx，
# 一旦提交就是不可撤销的泄露（历史里删不掉）。这里提前拦住。
*.pfx
*.p12
*.cer
*.crt
*.snk
*.sig
# 发布产物（tools/publish.ps1 生成）
/dist/


# ---- Ƥ�� agent �������Դ���� tools/skin-agent/src��----
/tools/skin-agent/out/
