<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!--
    默认编译成测试库，供 dotnet test 使用。
    加 -p:SelfTestRunner=true 时切成可执行程序，改用 SelfTestRunner.cs 里的反射 runner。
    原因：某些受限环境下 vstest 的 testhost 会在 SetParentProcessExitCallback 处
    因无法 OpenProcess 父进程而崩溃（Win32Exception 5: 拒绝访问），dotnet test 完全不可用。
    GenerateProgramFile=false 是为了阻止 Microsoft.NET.Test.Sdk 注入它自己的 Main。
  -->
  <PropertyGroup Condition="'$(SelfTestRunner)' == 'true'">
    <OutputType>Exe</OutputType>
    <GenerateProgramFile>false</GenerateProgramFile>
    <StartupObject>NPMC.Launcher.Core.Tests.SelfTestRunner</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NPMC.Launcher.Core\NPMC.Launcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="SelfTestRunner.cs" />
    <Compile Include="SelfTestRunner.cs" Condition="'$(SelfTestRunner)' == 'true'" />
  </ItemGroup>

</Project>